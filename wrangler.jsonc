{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shepherdit-business-card",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-23",
  "secrets": {
    "required": ["RE_API_KEY", "CONTACT_TO_EMAIL"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    {
      "pattern": "salsbury.org/api/*",
      "zone_name": "salsbury.org"
    }
  ]
}
